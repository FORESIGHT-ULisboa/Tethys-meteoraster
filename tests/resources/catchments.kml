					</outerBoundaryIs>
				</Polygon>
			</MultiGeometry>
		</Placemark>
		<atom:link rel="app" href="https://www.google.com/earth/about/versions/#earth-pro" title="Google Earth Pro 7.3.6.10441"></atom:link>
	</Folder>
</Document>
</kml>
